{
  "name": "@omestre/api",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --env-file ../../.env run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.2.0",
    "@omestre/converters": "workspace:*",
    "@omestre/db": "workspace:*",
    "@omestre/shared": "workspace:*",
    "@omestre/worker-common": "workspace:*",
    "elysia": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
