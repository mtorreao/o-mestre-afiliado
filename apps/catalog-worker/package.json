{
  "name": "@omestre/catalog-worker",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omestre/converters": "workspace:*",
    "@omestre/shared": "workspace:*",
    "@omestre/db": "workspace:*",
    "@omestre/worker-common": "workspace:*",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
