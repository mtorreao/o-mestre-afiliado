{
  "name": "o-mestre-afiliado",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "elysia": "^1.2.0",
    "ioredis": "^5.4.1",
    "drizzle-orm": "^0.38.0",
    "drizzle-kit": "^0.30.0",
    "hono": "^4.6.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:ingestor": "bun run --cwd apps/ingestor dev",
    "dev:dispatcher": "bun run --cwd apps/dispatcher dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:admin-api": "bun run --cwd apps/admin-api dev",
    "dev:admin-web": "bun run --cwd apps/admin-web dev",
    "build:api": "bun run --cwd apps/api build",
    "build:ingestor": "bun run --cwd apps/ingestor build",
    "build:dispatcher": "bun run --cwd apps/dispatcher build",
    "build:web": "bun run --cwd apps/web build",
    "build:admin-api": "bun run --cwd apps/admin-api build",
    "build:admin-web": "bun run --cwd apps/admin-web build",
    "build:extension": "bun run scripts/build-extension-config.ts",
    "build": "bun run build:api && bun run build:ingestor && bun run build:dispatcher && bun run build:catalog-worker && bun run build:web && bun run build:admin-api && bun run build:admin-web",
    "build:v2": "bun run build:api && bun run build:ingestor && bun run build:dispatcher && bun run build:catalog-worker && bun run build:web",
    "shopee": "bun run --cwd packages/converters shopee",
    "mercadolivre": "bun run --cwd packages/converters mercadolivre",
    "ml": "bun run --cwd packages/converters mercadolivre",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "deploy:local": "bun run scripts/deploy-local.ts",
    "healthcheck": "bun run scripts/healthcheck.ts",
    "healthcheck:alert": "bun run scripts/healthcheck.ts --alert",
    "typecheck": "bun run scripts/typecheck-all.ts",
    "typecheck:root": "tsc --noEmit",
    "test:unit": "bun run scripts/test-unit.ts",
    "test:coverage": "bun run scripts/test-coverage.ts",
    "test:all": "bun run test:unit && bun run test:e2e",
    "setup:hooks": "bun run scripts/setup-hooks.sh",
    "dev:catalog-worker": "bun run --cwd apps/catalog-worker dev",
    "build:catalog-worker": "bun run --cwd apps/catalog-worker build",
    "backfill": "bun run --cwd apps/catalog-worker backfill",
    "magalu": "bun run --cwd packages/converters magalu",
    "loadtest": "bun run apps/loadtest/src/index.ts",
    "loadtest:mock": "bun run apps/loadtest/src/index.ts --mock --all"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "concurrently": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5"
  }
}
