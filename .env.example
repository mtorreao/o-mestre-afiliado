# ═══════════════════════════════════════════════════════════════
# MERCADO LIVRE — Credenciais de Afiliados
# ═══════════════════════════════════════════════════════════════
#
# Escolha uma das 3 estratégias abaixo:

# ── ESTRATÉGIA 1: API OFICIAL OAuth 2.0 (RECOMENDADO) ──────
# Registre sua app em: https://developers.mercadolivre.com.br/
# App registrada: "O Mestre Afiliado" (App ID: 8762086145951776)
# Redirect URI configurada: https://omestreafiliado.com.br/
# ML_CLIENT_ID=seu_client_id
# ML_CLIENT_SECRET=seu_client_secret
# ML_REFRESH_TOKEN=seu_refresh_token

# Cookies de sessão SEMPRE atrelados ao usuário (via extensão Chrome → banco).
# Não usar variável de ambiente.

# ═══════════════════════════════════════════════════════════════
# AMAZON — Associates
# ═══════════════════════════════════════════════════════════════
#
# Estratégia principal: cada afiliado cadastra seu próprio(s) tracking
# ID(s) via painel (/settings → aba Amazon) — armazenado na tabela
# omestre.amazon_affiliates (até 100 tracking IDs por afiliado).
#
# AMAZON_TRACKING_ID abaixo é FALLBACK GLOBAL: usado quando o conversor
# é chamado sem credenciais explícitas do afiliado (ex: CLI `bun run
# amazon <url>` ou ingestor sem afiliado vinculado). Deixe comentado
# em produção — use o painel por afiliado.
#
# AMAZON_TRACKING_ID=meusite-20
#
# ═══════════════════════════════════════════════════════════════
# MAGAZINE LUIZA — Influenciador Magalu (Magazine Você)
# ═══════════════════════════════════════════════════════════════
#
# Estratégia principal: cada afiliado cadastra seu próprio slug da loja
# via painel (/settings → aba Magalu) — armazenado na tabela
# omestre.magalu_affiliates (1 slug por afiliado).
#
# Slug = nome da loja no Magazine Você, definido no cadastro do
# programa Influenciador Magalu (ex: "magazinetorre"). Aparece na URL
# https://www.magazinevoce.com.br/{slug}/...
#
# MAGALU_STORE_NAME abaixo é FALLBACK GLOBAL: usado quando o conversor
# é chamado sem credenciais explícitas do afiliado (ex: CLI `bun run
# magalu <url>` ou POST /api/convert legado). Deixe comentado em
# produção — use o painel por afiliado.
#
# MAGALU_STORE_NAME=magazineseunome


# ═══════════════════════════════════════════════════════════════
# EVOLUTION API — Infraestrutura (docker-compose.infra.yml)
# ═══════════════════════════════════════════════════════════════
#
# Essas variáveis são usadas pelo docker-compose.infra.yml
# Para usar, crie um .env.infra na raiz com os valores reais
# (veja .env.infra para template completo)
#
# EVOLUTION_API_KEY=
# EVOLUTION_API_URL=http://localhost:5444
# EVOLUTION_WEBHOOK_URL=
#
# POSTGRES_DATABASE=omestre_db        # Banco compartilhado
# POSTGRES_USERNAME=evolution
# POSTGRES_PASSWORD=
# POSTGRES_PORT=127.0.0.1:5443:5432     # 5443 no host → 5432 no container
#
#
# ═══════════════════════════════════════════════════════════════
# REVALIDAÇÃO PERIÓDICA — Worker de validação de grupos
# ═══════════════════════════════════════════════════════════════
# Define de quantos em quantos dias os grupos fonte são revalidados.
# Um grupo que antes passava (≥70%) e cair abaixo do threshold
# dispara um alerta nos logs do worker.
# REVALIDATION_INTERVAL_DAYS=7

# ═══════════════════════════════════════════════════════════════
# WORKER v2 (INGESTOR) — Métricas de saúde
# ═══════════════════════════════════════════════════════════════
# URL para a API interna de métricas do Ingestor (pipeline pesado).
# Dentro do Docker Compose, a API container usa http://ingestor:9092.
# O default em apps/api/src/index.ts é http://localhost:9092 (host dev).
# WORKER_METRICS_URL=http://ingestor:9092
#
# Dispatcher (envio) expõe métricas em :9093.

# ═══════════════════════════════════════════════════════════════
# SEGURANÇA — Criptografia e autenticação
# ═══════════════════════════════════════════════════════════════
# Chave AES-256-GCM para criptografar sessionCookies em ml_affiliates.
# Gere com: openssl rand -hex 32
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chave de API para autenticar requisições ao servidor de métricas do worker.
# Se não configurada, o servidor de métricas fica aberto (compat retroativa).
# METRICS_API_KEY=

# ═══════════════════════════════════════════════════════════════
# EXTENSÃO CHROME — Logs remotos
# ═══════════════════════════════════════════════════════════════
# Chave dedicada para a extensão enviar logs estruturados.
# Escopo: APENAS POST /api/extension/logs (não permite ler nada).
# Gere com: openssl rand -hex 32
# Se vazia, o endpoint rejeita todas as requisições.
# Configure a mesma chave em Configurações da extensão (opcional).
# EXTENSION_LOGS_API_KEY=

# ═══════════════════════════════════════════════════════════════
# ADMIN BOOTSTRAP — emails que viram admin automaticamente
# ═══════════════════════════════════════════════════════════════
# CSV (separado por vírgula) de emails que ganham is_admin=true
# no momento do login/register. Match case-insensitive, exato.
# Vazio = ninguém vira admin via env (use UPDATE manual no DB).
# Sem tela de gestão de admins nesta fase.
# ADMIN_EMAILS=admin@seudominio.com,voce@gmail.com

# ═══════════════════════════════════════════════════════════════
# ADMIN-CENTER — Painel administrativo (apps/admin-api)
# ═══════════════════════════════════════════════════════════════
# Porta do Hono (dev usa 9090; prod via tunnel admin.omestreafiliado.com.br)
# ADMIN_API_PORT=9090

# Usuário único do painel (login com senha)
# OMA_ADMIN_USER=admin

# Hash argon2id da senha. Gere com:
#   bun run --cwd apps/admin-api hash-password -- "sua-senha"
# OMA_ADMIN_PASSWORD_HASH=

# Chave pública Ed25519 (base64, 32 bytes) que valida o webhook do GitHub Action.
# Gere o par com: openssl genpkey -algorithm ed25519 -out priv.pem
#                 openssl pkey -in priv.pem -pubout
# Publique a pública no .env, a privada fica SÓ no GitHub Secrets (OMA_DEPLOY_PRIVATE_KEY).
# OMA_DEPLOY_PUBLIC_KEY=

# Script de deploy executado no VPS (mount no container /scripts)
# OMA_DEPLOY_SCRIPT=/scripts/deploy-prod.sh

# Timeout do deploy (ms)
# OMA_DEPLOY_TIMEOUT_MS=600000

# Telegram (bot do @BotFather + chat_id do grupo/canal)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
