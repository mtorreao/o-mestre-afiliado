{
  "manifest_version": 3,
  "name": "O Mestre Afiliado",
  "description": "Sincroniza e valida a sessão do Mercado Livre e Magazine Você para operações de afiliado",
  "version": "1.6.21",
  "permissions": ["alarms", "cookies", "notifications", "storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.magazinevoce.com.br/*",
    "https://dev.omestreafiliado.com.br/*",
    "http://127.0.0.1:5441/*",
    "http://127.0.0.1:5442/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "O Mestre Afiliado",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://dev.omestreafiliado.com.br/*"],
      "js": ["lib/log-sink.config.js", "lib/log.js", "lib/log-sink.js", "content/auth-sync.js"],
      "run_at": "document_idle"
    }
  ]
}
