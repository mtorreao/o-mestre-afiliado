{
  "manifest_version": 3,
  "name": "O Mestre Afiliado — Cookie Importer",
  "description": "Sincroniza e valida a sessão do Mercado Livre para operações de afiliado",
  "version": "1.3.0",
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "storage",
    "tabs",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.mercadolivre.com/*",
    "https://*.shopee.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com/*",
    "https://dev.omestreafiliado.com.br/*",
    "http://127.0.0.1:5441/*",
    "http://127.0.0.1:5442/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "O Mestre Afiliado",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*",
        "https://*.mercadolivre.com/*"
      ],
      "js": ["content/mercadolivre.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.shopee.com.br/*"],
      "js": ["content/shopee.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.amazon.com.br/*", "https://*.amazon.com/*"],
      "js": ["content/amazon.js"],
      "run_at": "document_idle"
    }
  ]
}
