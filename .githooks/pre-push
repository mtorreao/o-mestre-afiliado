#!/usr/bin/env bash
# Pre-push hook — bloqueia push de código que não builda/testa.
#
# Roda, em ordem:
#   1. typecheck (todos os subprojetos)
#   2. test:unit (unit tests, ~5s)
#   3. build (todos os apps)
#
# Skip automático se nenhum arquivo de apps/ ou packages/ mudou
# (commits só de docs, scripts, configs).

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Verifica se algum arquivo de apps/ ou packages/ mudou em algum
# commit que ainda não foi pro remote
APPS_OR_PKGS_CHANGED=$(git diff --name-only @{u}..HEAD 2>/dev/null | grep -E "^(apps|packages)/" || true)

if [ -z "$APPS_OR_PKGS_CHANGED" ]; then
  echo "pre-push: nenhum apps/ ou packages/ mudou, pulando guards."
  exit 0
fi

CHANGED_COUNT=$(echo "$APPS_OR_PKGS_CHANGED" | wc -l)
echo ""
echo "🪝 pre-push: $CHANGED_COUNT arquivo(s) em apps/packages modificados"
echo ""

# ── 1. Typecheck ────────────────────────────────────────────────
echo "▶ [1/3] bun run typecheck..."
if ! bun run typecheck; then
  echo ""
  echo "❌ Typecheck falhou. Corrija antes de pushar."
  echo "   (use 'git push --no-verify' apenas em emergências)"
  exit 1
fi

# ── 2. Unit tests ──────────────────────────────────────────────
echo ""
echo "▶ [2/3] bun run test:unit..."
if ! bun run test:unit; then
  echo ""
  echo "❌ Unit tests falharam. Corrija antes de pushar."
  echo "   (use 'git push --no-verify' apenas em emergências)"
  exit 1
fi

# ── 3. Build ────────────────────────────────────────────────────
echo ""
echo "▶ [3/3] bun run build..."
if ! bun run build; then
  echo ""
  echo "❌ Build falhou. Corrija antes de pushar."
  echo "   (use 'git push --no-verify' apenas em emergências)"
  exit 1
fi

echo ""
echo "✅ pre-push: guards passaram."
exit 0
